# Required for production
MONGODB_URI=
AUTH_JWT_SECRET=
APP_URL=
DEMO_USER_ID=demo-admin

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAILS=
GOOGLE_DEFAULT_PROJECT_SLUG=acme-retail

# AI provider: Gemini
